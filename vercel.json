{
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm install --omit=dev",
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["fra1"],
  "functions": { "api/router.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?__p=:path*" },
    { "source": "/boshqaruv", "destination": "/admin" }
  ],
  "headers": [
    { "source": "/(.*)\\.(html|js|css|webmanifest)", "headers": [{ "key": "cache-control", "value": "no-cache" }] },
    { "source": "/(kassa|boshqaruv|ofitsiant|oshxona)", "headers": [{ "key": "cache-control", "value": "no-cache" }] },
    { "source": "/", "headers": [{ "key": "cache-control", "value": "no-cache" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }] }
  ]
}
